#!/bin/sh
set -e

DISTRIBUTION="${DEBIAN_VERSION:-trixie}"

# The package lists use trixie-only t64 names (libgtk-3-0t64,
# libasound2t64, ...). Fail early instead of after a long bootstrapping run.
case "${DISTRIBUTION}" in
    trixie)
        ;;
    *)
        echo "ERROR: this image targets Debian 13 (trixie); got '${DISTRIBUTION}'." >&2
        exit 1
        ;;
esac

# Pin the debootstrap base system to an immutable Debian snapshot, so a
# rebuild does not silently pick up newer essential packages.
# Set DEBIAN_SNAPSHOT="live" to build against the current archive instead.
#
# Only bootstrap is pinned on purpose: live-build copies the *chroot* mirror
# into the final /etc/apt/sources.list, so pinning chroot would leave the live
# session and the Calamares-installed system pointing at a stale snapshot
# without security updates. Chroot and binary therefore use the live mirror.
SNAPSHOT="${DEBIAN_SNAPSHOT:-20261031T000000Z}"
case "${SNAPSHOT}" in
    ""|live|none)
        PARENT_MIRROR_BOOTSTRAP="http://deb.debian.org/debian/"
        APT_OPTIONS="--yes"
        ;;
    *)
        PARENT_MIRROR_BOOTSTRAP="https://snapshot.debian.org/archive/debian/${SNAPSHOT}/"
        # Snapshot Release files keep the original Valid-Until date. Their
        # content is immutable, so accept it instead of failing the build.
        APT_OPTIONS="--yes -oAcquire::Check-Valid-Until=false"
        ;;
esac

# Debian 13 (Trixie) is Debian Stable: updates and security repositories are active.
UPDATES="true"

lb config noauto \
    --mode debian \
    --distribution "${DISTRIBUTION}" \
    --architecture amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --parent-mirror-bootstrap "${PARENT_MIRROR_BOOTSTRAP}" \
    --parent-mirror-chroot "http://deb.debian.org/debian/" \
    --parent-mirror-binary "http://deb.debian.org/debian/" \
    --parent-mirror-chroot-security "http://security.debian.org/debian-security/" \
    --parent-mirror-binary-security "http://security.debian.org/debian-security/" \
    --apt-options "${APT_OPTIONS}" \
    --chroot-squashfs-compression-type zstd \
    --binary-image iso-hybrid \
    --bootloaders grub-efi \
    --bootappend-live "boot=live components quiet splash snd_intel_dspcfg.dsp_driver=3 console=ttyS0,115200 console=tty0" \
    --system live \
    --linux-flavours amd64 \
    --linux-packages "linux-image" \
    --memtest none \
    --iso-application "Debian 13 Labwc Lenovo 300e" \
    --iso-publisher "Custom SecureBoot Build" \
    --iso-volume "DEBIAN_LIVE" \
    --security true \
    --updates "${UPDATES}" \
    --apt-recommends true \
    "${@}"
