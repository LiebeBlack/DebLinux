#!/bin/sh
set -e

DISTRIBUTION="${DEBIAN_VERSION:-trixie}"

# Debian 13 (Trixie) is Debian Stable: updates and security repositories are fully active
if [ "${DISTRIBUTION}" = "testing" ] || [ "${DISTRIBUTION}" = "sid" ] || [ "${DISTRIBUTION}" = "unstable" ]; then
    UPDATES="false"
else
    UPDATES="true"
fi

lb config noauto \
    --mode debian \
    --distribution "${DISTRIBUTION}" \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --parent-mirror-bootstrap "http://deb.debian.org/debian/" \
    --parent-mirror-chroot "http://deb.debian.org/debian/" \
    --parent-mirror-binary "http://deb.debian.org/debian/" \
    --binary-images iso-hybrid \
    --bootloader grub-efi \
    --bootappend-live "boot=live components quiet splash snd_intel_dspcfg.dsp_driver=3" \
    --system live \
    --linux-flavours amd64 \
    --linux-packages "linux-image" \
    --memtest none \
    --iso-application "Debian 13 Labwc Lenovo 300e" \
    --iso-publisher "Custom SecureBoot Build" \
    --iso-volume "DEBIAN_LIVE" \
    --security true \
    --updates "${UPDATES}" \
    --apt-recommends true \
    "${@}"
