<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <menu id="root-menu" label="Applications">
    <!-- installer-entry-start -->
    <item label="Install MAXT_OS to Disk (Calamares)">
      <action name="Execute" command="launch-calamares" />
    </item>
    <separator />
    <!-- installer-entry-end -->
    <item label="Terminal (Foot)">
      <action name="Execute" command="foot" />
    </item>
    <item label="Web Browser (Firefox Nightly)">
      <action name="Execute" command="firefox-nightly" />
    </item>
    <item label="File Manager (PCManFM)">
      <action name="Execute" command="pcmanfm" />
    </item>
    <item label="Application Launcher (Fuzzel)">
      <action name="Execute" command="fuzzel" />
    </item>
    <separator />
    <item label="Audio Volume Control (Pavucontrol)">
      <action name="Execute" command="pavucontrol" />
    </item>
    <item label="Network Connections (Wi-Fi)">
      <action name="Execute" command="foot -e nmtui" />
    </item>
    <separator />
    <item label="Display Settings (wlr-randr)">
      <action name="Execute" command="foot -e wlr-randr" />
    </item>
    <item label="Input Devices (xinput list)">
      <action name="Execute" command="foot -e xinput list" />
    </item>
    <separator />
    <item label="Switch to Text Mode">
      <action name="Execute" command="switch-to-text" />
    </item>
    <item label="Reload Labwc Configuration">
      <action name="Reconfigure" />
    </item>
    <item label="Exit Labwc">
      <action name="Exit" />
    </item>
    <separator />
    <item label="Reboot System">
      <action name="Execute" command="systemctl reboot" />
    </item>
    <item label="Power Off">
      <action name="Execute" command="systemctl poweroff" />
    </item>
  </menu>
</openbox_menu>
