#!/bin/sh
# ~/.config/labwc/autostart
# Executed by Labwc upon session startup

if command -v pipewire >/dev/null 2>&1; then
    pgrep -u "$USER" -x "pipewire" >/dev/null 2>&1 || pipewire &
fi

if command -v pipewire-pulse >/dev/null 2>&1; then
    pgrep -u "$USER" -x "pipewire-pulse" >/dev/null 2>&1 || pipewire-pulse &
fi

if command -v wireplumber >/dev/null 2>&1; then
    pgrep -u "$USER" -x "wireplumber" >/dev/null 2>&1 || wireplumber &
fi

if command -v mako >/dev/null 2>&1; then
    pgrep -u "$USER" -x "mako" >/dev/null 2>&1 || mako &
fi

if command -v nm-applet >/dev/null 2>&1; then
    pgrep -u "$USER" -x "nm-applet" >/dev/null 2>&1 || nm-applet --indicator &
fi

if command -v waybar >/dev/null 2>&1; then
    pgrep -u "$USER" -x "waybar" >/dev/null 2>&1 || waybar &
fi

if command -v swaybg >/dev/null 2>&1; then
    swaybg -c "#1a1b26" &
fi

if command -v swayidle >/dev/null 2>&1 && command -v swaylock >/dev/null 2>&1; then
    pgrep -u "$USER" -x "swayidle" >/dev/null 2>&1 || swayidle -w \
        timeout 300 'swaylock -f -c 1a1b26' \
        timeout 600 'systemctl suspend' \
        before-sleep 'swaylock -f -c 1a1b26' &
fi

