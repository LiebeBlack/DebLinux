<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>4</gap>
  </core>

  <!-- Touchpad and Keyboard configuration for Lenovo 300e -->
  <libinput>
    <device type="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
      <tapAndDrag>yes</tapAndDrag>
      <accelSpeed>0.2</accelSpeed>
    </device>
  </libinput>

  <keyboard>
    <default />
    <!-- Application Shortcuts -->
    <keybind key="W-t">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="pcmanfm" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-S-e">
      <action name="Exit" />
    </keybind>
    <keybind key="W-S-q">
      <action name="Exit" />
    </keybind>

    <!-- Window Management -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>

    <!-- Audio Volume Controls via PipeWire wireplumber (wpctl) -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>

    <!-- Laptop Screen Brightness Controls via brightnessctl -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set +5%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-" />
    </keybind>

    <!-- Screenshot Shortcuts -->
    <keybind key="Print">
      <action name="Execute" command="grim ~/screenshot-$(date +%s).png" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="slurp | grim -g - ~/screenshot-$(date +%s).png" />
    </keybind>
  </keyboard>

  <!-- Mouse Bindings -->
  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
  </mouse>
</labwc_config>
