#!/bin/sh
# /usr/local/bin/launch-labwc
# Wrapper script to prepare the environment and execute labwc

set -e

# Ensure XDG_RUNTIME_DIR exists with correct permissions (0700)
if [ -z "${XDG_RUNTIME_DIR}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
if [ ! -d "${XDG_RUNTIME_DIR}" ]; then
    mkdir -p "${XDG_RUNTIME_DIR}"
    chmod 0700 "${XDG_RUNTIME_DIR}"
fi

# Session & Desktop Identification
export XDG_CURRENT_DESKTOP=labwc
export XDG_SESSION_DESKTOP=labwc
export XDG_SESSION_TYPE=wayland

# Toolkit Wayland Backends
export GDK_BACKEND=wayland,x11,*
export QT_QPA_PLATFORM=wayland;xcb
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1

# Intel Graphics & Hardware Acceleration (Intel Celeron N4120 / UHD 600)
export LIBVA_DRIVER_NAME=iHD
export MESA_LOADER_DRIVER_OVERRIDE=iris

# Enable XWayland support in wlroots/labwc
export WLR_XWAYLAND=1

# Seat management execution
if command -v seatd-launch >/dev/null 2>&1; then
    exec seatd-launch labwc
else
    exec labwc
fi
