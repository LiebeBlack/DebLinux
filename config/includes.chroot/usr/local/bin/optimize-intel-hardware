#!/bin/bash
# Post-installation optimization script for Intel hardware
# Minimal and essential optimizations only
# Fully automated - no user intervention required

set +e

CONFIG_FILE="/etc/intel-hardware.conf"
LOG_FILE="/var/log/intel-hardware-optimization.log"

echo "=== Intel Hardware Optimization Started ===" | tee -a "$LOG_FILE"
echo "Date: $(date)" | tee -a "$LOG_FILE"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Warning: Hardware configuration file not found. Skipping optimization." | tee -a "$LOG_FILE"
    exit 0
fi

source "$CONFIG_FILE"

if [ "$INTEL_GPU" = "true" ]; then
    echo "--- Optimizing for Intel GPU ---" | tee -a "$LOG_FILE"
    mkdir -p /etc/modprobe.d
    if [ "$INTEL_ARC" = "true" ]; then
        echo "Optimizing for Intel Arc" | tee -a "$LOG_FILE"
        echo "options i915 enable_guc=3 enable_fbc=1" > /etc/modprobe.d/i915.conf
    else
        echo "Optimizing for Intel integrated GPU" | tee -a "$LOG_FILE"
        echo "options i915 enable_guc=2 enable_fbc=1" > /etc/modprobe.d/i915.conf
    fi
fi

if [ "$INTEL_CPU" = "true" ]; then
    echo "--- Optimizing for Intel CPU ---" | tee -a "$LOG_FILE"
    if [ -f /etc/default/grub ]; then
        if ! grep -q "intel_iommu=on" /etc/default/grub; then
            sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="[^"]*/& intel_iommu=on iommu=pt/' /etc/default/grub
        fi
    fi
fi

if [ "$INTEL_WIFI" = "true" ]; then
    echo "--- Optimizing for Intel WiFi ---" | tee -a "$LOG_FILE"
    mkdir -p /etc/modprobe.d
    echo "options iwlwifi power_save=1" > /etc/modprobe.d/iwlwifi.conf
fi

if [ "$INTEL_AUDIO" = "true" ]; then
    echo "--- Optimizing for Intel Audio ---" | tee -a "$LOG_FILE"
    mkdir -p /etc/modprobe.d
    echo "options snd_hda_intel power_save=1" > /etc/modprobe.d/snd_hda_intel.conf
fi

# Persist the changes: modprobe options only reach the early i915 load through
# the initramfs, and the IOMMU flag needs a regenerated grub.cfg.
if [ -f /etc/modprobe.d/i915.conf ] || [ -f /etc/modprobe.d/iwlwifi.conf ] || [ -f /etc/modprobe.d/snd_hda_intel.conf ]; then
    if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -u -k all >/dev/null 2>&1 || true
    fi
fi
if command -v update-grub >/dev/null 2>&1; then
    update-grub >/dev/null 2>&1 || true
fi

echo "=== Intel Hardware Optimization Completed ===" | tee -a "$LOG_FILE"

